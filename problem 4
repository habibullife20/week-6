#include <iostream>
using namespace std;

int smallestRepunitDivByK(int k) {
    int r = 1 % k;

    for (int length = 1; length <= k; length++) {
        if (r == 0) {
            return length;
        }
        r = (r * 10 + 1) % k;
    }

    return -1;
}

int main() {
    int k;
    cin >> k;

    cout << smallestRepunitDivByK(k) << endl;

    return 0;
}
